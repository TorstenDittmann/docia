{
	"name": "docia",
	"version": "0.0.15",
	"description": "Fast, static, agent-ready documentation sites from Markdown.",
	"keywords": [
		"bun",
		"documentation",
		"llms-txt",
		"markdown",
		"static-site-generator"
	],
	"homepage": "https://docia.xyz",
	"bugs": {
		"url": "https://github.com/TorstenDittmann/docia/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TorstenDittmann/docia.git"
	},
	"bin": {
		"docia": "./src/cli.ts"
	},
	"files": [
		"src",
		"README.md"
	],
	"type": "module",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"docia": "bun run src/cli.ts --config docs/docia.config.ts",
		"build": "bun run src/cli.ts build --config docs/docia.config.ts",
		"dev": "bun run src/cli.ts dev --config docs/docia.config.ts",
		"serve": "bun run src/cli.ts serve --config docs/docia.config.ts",
		"check": "bun run src/cli.ts check --config docs/docia.config.ts",
		"test": "bun test --parallel",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"deps:check": "bun dedupe --check",
		"verify": "bun run --parallel lint fmt:check typecheck test deps:check",
		"prepublishOnly": "bun run verify",
		"build:binary": "bun build --compile --asset ./package.json ./src/cli.ts --outfile docia",
		"build:binaries": "bun run scripts/build-binaries.ts"
	},
	"dependencies": {
		"minisearch": "^7.2.0",
		"picocolors": "^1.1.1",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"shiki": "^3.22.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"oxfmt": "^0.28.0",
		"oxlint": "^1.43.0",
		"typescript": "^5.9.3"
	},
	"engines": {
		"bun": ">=1.4.0"
	},
	"packageManager": "bun@1.4.0"
}
